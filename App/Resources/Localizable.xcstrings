    "att.body1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ads keep Keystone free. iOS will ask if they can be more relevant to you."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reklamlar Denge Noktası'nı ücretsiz tutar. iOS, reklamların sana daha uygun olup olamayacağını soracak."
          }
        }
      }
    },
    "att.body2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Either answer is fine. The game stays the same."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki cevap da olur. Oyun aynı kalır."
          }
